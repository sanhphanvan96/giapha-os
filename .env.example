# -----------------------------------------------------------------------------
# GIA PHẢ OS - MẪU BIẾN MÔI TRƯỜNG CẤU HÌNH (ENVIRONMENT VARIABLES)
# -----------------------------------------------------------------------------
# Hướng dẫn:
# 1. Chép (copy) file này thành ".env.local"
# 2. Điền các giá trị thực tế tương ứng với dự án Supabase của bạn

# Tên của ứng dụng web được hiển thị cho người dùng
SITE_NAME="Gia Phả Online"

# URL công khai của web (dùng cho OpenGraph metadata)
SITE_URL="https://your-domain.com"

# URL của project Supabase (Lấy từ Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Khóa Public (Lấy từ Settings > API > Project API keys > anon / public)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY="your-anon-or-public-key"

# Ẩn khỏi search engine (noindex). Đặt "true" để ngăn Google/Bing index trang.
NOINDEX="true"

# Khóa service_role (Lấy từ Settings > API > Project API keys > service_role)
# CHỈ dùng server-side, bypass RLS — KHÔNG prefix NEXT_PUBLIC_, không commit giá trị thật.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# VAPID keypair cho Web Push (tạo bằng: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:admin@your-domain.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
